# ============================================================
# GrassSea AI — 环境变量模板
# 复制此文件为 .env 并填入实际值
# ============================================================
APP_NAME=GrassSea
APP_VERSION=0.1.0
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-production

API_GATEWAY_PORT=8000
CHAT_SERVICE_PORT=8001
AGENT_SERVICE_PORT=8002
KNOWLEDGE_SERVICE_PORT=8003
MODEL_GATEWAY_PORT=8004

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=grasssea
POSTGRES_PASSWORD=change-me
POSTGRES_DB=grasssea

MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_USER=grasssea
MONGODB_PASSWORD=change-me
MONGODB_DB=grasssea

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

MILVUS_HOST=localhost
MILVUS_PORT=19530

MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=grasssea-files

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=grasssea
RABBITMQ_PASSWORD=change-me

NEO4J_HOST=localhost
NEO4J_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

CELERY_BROKER_URL=amqp://grasssea:change-me@localhost:5672/
CELERY_RESULT_BACKEND=redis://localhost:6379/1

JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
CLAUDE_API_KEY=your-claude-api-key
CLAUDE_BASE_URL=https://api.anthropic.com
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1

EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=3072
LOCAL_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

BRAVE_SEARCH_API_KEY=your-brave-search-api-key
BING_SEARCH_API_KEY=your-bing-search-api-key