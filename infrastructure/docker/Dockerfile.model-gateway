# ============================================================
# GrassSea AI — 模型网关 Dockerfile
# 模型网关需要独立的轻量镜像
# ============================================================
FROM python:3.11-slim-bookworm

LABEL maintainer="GrassSea AI Team"
LABEL project="grasssea-model-gateway"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    SERVICE_PORT=8004

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .
RUN pip install --upgrade pip && \
    pip install fastapi uvicorn[standard] httpx pydantic pydantic-settings \
    sqlalchemy asyncpg redis python-dotenv structlog openai \
    opentelemetry-api opentelemetry-sdk opentelemetry-instrumentation-fastapi

COPY . .

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD curl -f http://localhost:8004/health || exit 1

EXPOSE 8004

CMD ["uvicorn", "services.model_gateway.main:app", "--host", "0.0.0.0", "--port", "8004"]
